--!nonstrict
local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService      = game:GetService("TextService")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Theme = {
    WHITE       = Color3.fromRGB(255, 255, 255),
    PRIMARY     = Color3.fromRGB(37, 99, 235),
    PRIMARY_DK  = Color3.fromRGB(29, 78, 216),
    BORDER      = Color3.fromRGB(229, 231, 235),
    TEXT        = Color3.fromRGB(31, 41, 55),
    TEXT_MUTED  = Color3.fromRGB(156, 163, 175),
    HOVER_BG    = Color3.fromRGB(239, 246, 255),
    HOVER_SOFT  = Color3.fromRGB(248, 251, 255),
    PANEL_SOFT  = Color3.fromRGB(249, 250, 252),
    TRACK       = Color3.fromRGB(229, 231, 235),
    DISABLED_BG = Color3.fromRGB(249, 250, 251),
    DISABLED_FG = Color3.fromRGB(209, 213, 219),
    SHADOW      = Color3.fromRGB(15, 23, 42),
}

local FONT_REG = Enum.Font.Gotham
local FONT_MED = Enum.Font.GothamMedium

local EASE      = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local EASE_FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local EASE_BACK = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local EASE_IN   = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local EASE_NONE = TweenInfo.new(0, Enum.EasingStyle.Linear)

local function tw(o, i, p)
    local t = TweenService:Create(o, i, p)
    t:Play()
    return t
end

local function tapPulse(obj, prop, normal, peak, peakTime)
    peakTime = peakTime or 0.09
    local props = {}; props[prop] = peak
    local t1 = TweenService:Create(obj, TweenInfo.new(peakTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t1.Completed:Connect(function()
        local back = {}; back[prop] = normal
        TweenService:Create(obj, EASE_BACK, back):Play()
    end)
    t1:Play()
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = p
    return c
end

local function stroke(p, c, t)
    local s = Instance.new("UIStroke")
    s.Color = c or Theme.BORDER
    s.Thickness = t or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

local uiGui = Instance.new("ScreenGui")
uiGui.Name = "LumenUI"
uiGui.ResetOnSpawn = false
uiGui.IgnoreGuiInset = true
uiGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
uiGui.DisplayOrder = 100
uiGui.Parent = playerGui

local listLayer = Instance.new("Frame")
listLayer.Name = "DropdownLayer"
listLayer.BackgroundTransparency = 1
listLayer.Size = UDim2.new(1, 0, 1, 0)
listLayer.ZIndex = 90
listLayer.Parent = uiGui

local activeDropdownClose = nil

local interceptLayer = Instance.new("TextButton")
interceptLayer.Name = "DropdownIntercept"
interceptLayer.BackgroundTransparency = 1
interceptLayer.Text = ""
interceptLayer.AutoButtonColor = false
interceptLayer.Modal = false
interceptLayer.Size = UDim2.new(1, 0, 1, 0)
interceptLayer.Visible = false
interceptLayer.ZIndex = 89
interceptLayer.Parent = listLayer

interceptLayer.MouseButton1Click:Connect(function()
    if activeDropdownClose then activeDropdownClose() end
end)

local function resolveParent(cfg)
    return (cfg and cfg.parent) or uiGui
end

local function createLabel(parent, cfg)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = cfg.text or ""
    lbl.TextColor3 = cfg.color or Theme.TEXT
    lbl.TextSize = cfg.textSize or 12
    lbl.Font = cfg.font or FONT_REG
    lbl.TextXAlignment = cfg.align or Enum.TextXAlignment.Left
    lbl.TextYAlignment = cfg.vAlign or Enum.TextYAlignment.Center
    lbl.TextWrapped = cfg.wrapped or false
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Position = UDim2.new(0, cfg.x or 0, 0, cfg.y or 0)
    lbl.Size = UDim2.new(0, cfg.w or 100, 0, cfg.h or 20)
    lbl.ZIndex = cfg.zIndex or 5
    lbl.Parent = parent
    return lbl
end

--=================== Panel（带 Tab + 缩放手柄） ===================
local function createPanel(parent, cfg)
    cfg = cfg or {}
    local W, H = cfg.w or 360, cfg.h or 260
    local X, Y = cfg.x or 0, cfg.y or 0
    local RADIUS = cfg.radius or 12
    local Z = cfg.zIndex or 4
    local hasTitle = cfg.title ~= nil
    local TITLE_H = hasTitle and (cfg.titleHeight or 34) or 0
    local tabNames = cfg.tabs
    local hasTabs = type(tabNames) == "table" and #tabNames > 0
    local TAB_H = hasTabs and (cfg.tabHeight or 36) or 0

    local shadow = nil
    if cfg.shadow ~= false then
        shadow = Instance.new("Frame")
        shadow.BackgroundColor3 = Theme.SHADOW
        shadow.BackgroundTransparency = 0.92
        shadow.BorderSizePixel = 0
        shadow.Position = UDim2.new(0, X - 2, 0, Y + 2)
        shadow.Size = UDim2.new(0, W + 4, 0, H + 4)
        shadow.ZIndex = Z - 1
        corner(shadow, RADIUS + 2)
        shadow.Parent = parent
    end

    local panel = Instance.new("Frame")
    panel.BackgroundColor3 = cfg.bgColor or Theme.WHITE
    panel.BorderSizePixel = 0
    panel.Position = UDim2.new(0, X, 0, Y)
    panel.Size = UDim2.new(0, W, 0, H)
    panel.ZIndex = Z
    panel.ClipsDescendants = true
    corner(panel, RADIUS)
    stroke(panel, cfg.borderColor or Theme.BORDER, 1)
    panel.Parent = parent

    local function syncShadow()
        if not shadow then return end
        shadow.Position = UDim2.new(0, panel.Position.X.Offset - 2, 0, panel.Position.Y.Offset + 2)
        shadow.Size = UDim2.new(0, panel.Size.X.Offset + 4, 0, panel.Size.Y.Offset + 4)
    end
    panel:GetPropertyChangedSignal("Position"):Connect(syncShadow)
    panel:GetPropertyChangedSignal("Size"):Connect(syncShadow)

    local titleBar = nil
    if hasTitle then
        titleBar = Instance.new("Frame")
        titleBar.BackgroundColor3 = cfg.titleBgColor or (cfg.bgColor or Theme.WHITE)
        titleBar.BorderSizePixel = 0
        titleBar.Position = UDim2.new(0, 0, 0, 0)
        titleBar.Size = UDim2.new(1, 0, 0, TITLE_H)
        titleBar.ZIndex = Z + 1
        corner(titleBar, RADIUS)
        titleBar.Parent = panel

        createLabel(titleBar, {
            text = cfg.title, x = 16, y = 0, w = W - 80, h = TITLE_H,
            textSize = cfg.titleSize or 13, color = cfg.titleColor or Theme.TEXT,
            font = FONT_MED, zIndex = Z + 2,
        })

        if not hasTabs then
            local line = Instance.new("Frame")
            line.BackgroundColor3 = cfg.borderColor or Theme.BORDER
            line.BorderSizePixel = 0
            line.AnchorPoint = Vector2.new(0, 1)
            line.Position = UDim2.new(0, 0, 1, 0)
            line.Size = UDim2.new(1, 0, 0, 1)
            line.ZIndex = Z + 2
            line.Parent = titleBar
        end
    end

    if cfg.onClose then
        local closeBtn = Instance.new("TextButton")
        closeBtn.BackgroundColor3 = cfg.bgColor or Theme.WHITE
        closeBtn.BackgroundTransparency = 1
        closeBtn.BorderSizePixel = 0
        closeBtn.Text = "×"
        closeBtn.TextColor3 = Theme.TEXT_MUTED
        closeBtn.TextSize = 16
        closeBtn.Font = FONT_MED
        closeBtn.AutoButtonColor = false
        closeBtn.AnchorPoint = Vector2.new(1, 0.5)
        closeBtn.Position = UDim2.new(1, -8, 0, (hasTitle and TITLE_H or 0) / 2)
        closeBtn.Size = UDim2.new(0, 24, 0, 24)
        closeBtn.ZIndex = Z + 3
        corner(closeBtn, 6)
        closeBtn.Parent = titleBar or panel

        closeBtn.MouseEnter:Connect(function()
            closeBtn.BackgroundTransparency = 0
            tw(closeBtn, EASE_FAST, { BackgroundColor3 = Theme.HOVER_BG, TextColor3 = Theme.PRIMARY_DK })
        end)
        closeBtn.MouseLeave:Connect(function()
            tw(closeBtn, EASE, { TextColor3 = Theme.TEXT_MUTED })
            task.delay(0.22, function() closeBtn.BackgroundTransparency = 1 end)
        end)
        closeBtn.MouseButton1Click:Connect(function()
            cfg.onClose()
        end)
    end

    if cfg.draggable ~= false then
        local dragHit = Instance.new("TextButton")
        dragHit.BackgroundTransparency = 1
        dragHit.Text = ""
        dragHit.AutoButtonColor = false
        dragHit.Position = UDim2.new(0, 0, 0, 0)
        dragHit.Size = UDim2.new(1, 0, 0, hasTitle and TITLE_H or 20)
        dragHit.ZIndex = Z + 2
        dragHit.Parent = titleBar or panel

        local dragging = false
        local dragStart, startPos
        dragHit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = panel.Position
                if activeDropdownClose then
                    activeDropdownClose()
                    activeDropdownClose = nil
                end
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                local dx = input.Position.X - dragStart.X
                local dy = input.Position.Y - dragStart.Y
                local vp = workspace.CurrentCamera.ViewportSize
                if vp.X <= 0 or vp.Y <= 0 then return end
                local minX = -panel.Size.X.Offset + 40
                local maxX = vp.X - 40
                local minY = 0
                local maxY = vp.Y - 20
                local nx = math.clamp(startPos.X.Offset + dx, minX, maxX)
                local ny = math.clamp(startPos.Y.Offset + dy, minY, maxY)
                panel.Position = UDim2.new(0, nx, 0, ny)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local tabBar = nil
    local pageContainer = nil
    local pages = {}
    local tabButtons = {}
    local tabHl = nil
    local currentTab = 1

    local function selectTab(index, animate)
        if not hasTabs then return end
        if index < 1 or index > #pages then return end
        if currentTab == index and animate ~= false then return end
        local prev = pages[currentTab]
        local nxt = pages[index]
        currentTab = index

        if tabButtons[index] and tabHl then
            local btn = tabButtons[index]
            tw(tabHl, animate and EASE or EASE_NONE, {
                Position = UDim2.new(0, btn.Position.X.Offset, 1, -2),
                Size = UDim2.new(0, btn.Size.X.Offset, 0, 2),
            })
        end

        for i, b in ipairs(tabButtons) do
            local target = (i == index) and Theme.PRIMARY_DK or Theme.TEXT_MUTED
            tw(b, animate and EASE or EASE_NONE, { TextColor3 = target })
        end

        if animate == false then
            for i, p in ipairs(pages) do
                p.Visible = (i == index)
                p.GroupTransparency = (i == index) and 0 or 1
                p.Position = UDim2.new(0, 0, 0, 0)
            end
            return
        end
        if prev and prev ~= nxt then
            local closing = prev
            tw(closing, EASE, {
                GroupTransparency = 1,
                Position = UDim2.new(0, -6, 0, 0),
            })
            task.delay(0.24, function()
                if closing ~= pages[currentTab] then
                    closing.Visible = false
                    closing.Position = UDim2.new(0, 0, 0, 0)
                end
            end)
        end
        if nxt then
            nxt.Position = UDim2.new(0, 6, 0, 0)
            nxt.GroupTransparency = 1
            nxt.Visible = true
            tw(nxt, EASE, {
                GroupTransparency = 0,
                Position = UDim2.new(0, 0, 0, 0),
            })
        end
    end

    if hasTabs then
        tabBar = Instance.new("Frame")
        tabBar.BackgroundColor3 = cfg.bgColor or Theme.WHITE
        tabBar.BorderSizePixel = 0
        tabBar.Position = UDim2.new(0, 0, 0, TITLE_H)
        tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
        tabBar.ZIndex = Z + 1
        tabBar.Parent = panel

        local bottomLine = Instance.new("Frame")
        bottomLine.BackgroundColor3 = cfg.borderColor or Theme.BORDER
        bottomLine.BorderSizePixel = 0
        bottomLine.AnchorPoint = Vector2.new(0, 1)
        bottomLine.Position = UDim2.new(0, 0, 1, 0)
        bottomLine.Size = UDim2.new(1, 0, 0, 1)
        bottomLine.ZIndex = Z + 2
        bottomLine.Parent = tabBar

        tabHl = Instance.new("Frame")
        tabHl.BackgroundColor3 = Theme.PRIMARY
        tabHl.BorderSizePixel = 0
        tabHl.Position = UDim2.new(0, 0, 1, -2)
        tabHl.Size = UDim2.new(0, 0, 0, 2)
        tabHl.ZIndex = Z + 3
        tabHl.Parent = tabBar

        local textSz = cfg.tabSize or 12
        local padX = 18
        local cx = 14
        for i, name in ipairs(tabNames) do
            local ok, measured = pcall(function()
                return TextService:GetTextSize(tostring(name), textSz, FONT_MED, Vector2.new(300, 40))
            end)
            local txtW = ok and measured.X or (#tostring(name) * 8)
            local btnW = math.floor(txtW) + padX * 2

            local btn = Instance.new("TextButton")
            btn.BackgroundColor3 = Theme.WHITE
            btn.BackgroundTransparency = 1
            btn.BorderSizePixel = 0
            btn.Text = name
            btn.TextColor3 = (i == 1) and Theme.PRIMARY_DK or Theme.TEXT_MUTED
            btn.TextSize = textSz
            btn.Font = FONT_MED
            btn.AutoButtonColor = false
            btn.Position = UDim2.new(0, cx, 0, 4)
            btn.Size = UDim2.new(0, btnW, 1, -8)
            btn.ZIndex = Z + 2
            corner(btn, 6)
            btn.Parent = tabBar

            local capture = i
            btn.MouseEnter:Connect(function()
                if currentTab ~= capture then
                    btn.BackgroundTransparency = 0
                    tw(btn, EASE_FAST, { BackgroundColor3 = Theme.HOVER_SOFT, TextColor3 = Theme.PRIMARY })
                end
            end)
            btn.MouseLeave:Connect(function()
                if currentTab ~= capture then
                    tw(btn, EASE, { TextColor3 = Theme.TEXT_MUTED })
                    task.delay(0.22, function()
                        if currentTab ~= capture then
                            btn.BackgroundTransparency = 1
                        end
                    end)
                end
            end)
            btn.MouseButton1Click:Connect(function()
                btn.BackgroundTransparency = 1
                selectTab(capture)
            end)

            tabButtons[i] = btn
            cx = cx + btnW
        end

        pageContainer = Instance.new("Frame")
        pageContainer.BackgroundTransparency = 1
        pageContainer.Position = UDim2.new(0, 0, 0, TITLE_H + TAB_H)
        pageContainer.Size = UDim2.new(1, 0, 1, -(TITLE_H + TAB_H))
        pageContainer.ZIndex = Z + 1
        pageContainer.ClipsDescendants = true
        pageContainer.Parent = panel

        for i = 1, #tabNames do
            local p = Instance.new("CanvasGroup")
            p.BackgroundTransparency = 1
            p.Position = UDim2.new(0, 0, 0, 0)
            p.Size = UDim2.new(1, 0, 1, 0)
            p.GroupTransparency = (i == 1) and 0 or 1
            p.Visible = (i == 1)
            p.ZIndex = Z + 1
            p.Parent = pageContainer
            pages[i] = p
        end

        task.defer(function()
            task.wait(0.05)
            selectTab(1, false)
        end)
    end

    local body
    if hasTabs then
        body = pageContainer
    else
        body = Instance.new("Frame")
        body.BackgroundTransparency = 1
        body.Position = UDim2.new(0, 0, 0, TITLE_H)
        body.Size = UDim2.new(1, 0, 1, -TITLE_H)
        body.ZIndex = Z + 1
        body.Parent = panel
    end

    if cfg.resizable ~= false then
        local handleSize = 16
        local minW, minH = cfg.minWidth or 260, cfg.minHeight or 200

        local handle = Instance.new("TextButton")
        handle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        handle.BackgroundTransparency = 0.3
        handle.BorderSizePixel = 0
        handle.Text = ""
        handle.AutoButtonColor = false
        handle.AnchorPoint = Vector2.new(1, 1)
        handle.Position = UDim2.new(1, -4, 1, -4)
        handle.Size = UDim2.new(0, handleSize, 0, handleSize)
        handle.ZIndex = Z + 5
        corner(handle, 4)
        handle.Parent = panel

        for k = 1, 3 do
            local line = Instance.new("Frame")
            line.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
            line.BorderSizePixel = 0
            line.AnchorPoint = Vector2.new(1, 1)
            line.Position = UDim2.new(1, -3 - (k - 1) * 4, 1, -3)
            line.Size = UDim2.new(0, 2, 0, 2 + (k - 1) * 3)
            line.ZIndex = Z + 6
            corner(line, 1)
            line.Parent = handle
        end

        handle.MouseEnter:Connect(function()
            tw(handle, EASE_FAST, {
                BackgroundColor3 = Theme.HOVER_BG,
                BackgroundTransparency = 0,
            })
        end)
        handle.MouseLeave:Connect(function()
            tw(handle, EASE, {
                BackgroundColor3 = Color3.fromRGB(240, 240, 240),
                BackgroundTransparency = 0.3,
            })
        end)

        local resizing = false
        local resizeStart, startW, startH
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                resizeStart = input.Position
                startW = panel.Size.X.Offset
                startH = panel.Size.Y.Offset
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not resizing then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                local dx = input.Position.X - resizeStart.X
                local dy = input.Position.Y - resizeStart.Y
                local nw = math.max(startW + dx, minW)
                local nh = math.max(startH + dy, minH)
                panel.Size = UDim2.new(0, nw, 0, nh)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
    end

    return {
        frame = panel,
        body = body,
        titleBar = titleBar,
        tabBar = tabBar,
        tabs = pages,
        selectTab = selectTab,
        getCurrentTab = function() return currentTab end,
        setPosition = function(nx, ny)
            panel.Position = UDim2.new(0, nx, 0, ny)
        end,
        setSize = function(nw, nh)
            panel.Size = UDim2.new(0, nw, 0, nh)
        end,
        destroy = function()
            if shadow then shadow:Destroy() end
            panel:Destroy()
        end,
    }
end

--=================== Button ===================
local function createButton(parent, cfg)
    local W, H = cfg.w or 120, cfg.h or 34
    local X, Y = cfg.x or 0, cfg.y or 0

    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = cfg.bgColor or Theme.WHITE
    btn.BorderSizePixel = 0
    btn.Text = cfg.text or "Button"
    btn.TextColor3 = cfg.textColor or Theme.PRIMARY
    btn.TextSize = cfg.textSize or 12
    btn.Font = FONT_MED
    btn.AutoButtonColor = false
    btn.Position = UDim2.new(0, X, 0, Y)
    btn.Size = UDim2.new(0, W, 0, H)
    btn.ZIndex = cfg.zIndex or 5
    corner(btn, cfg.radius or 6)
    local st = stroke(btn, cfg.borderColor or Theme.PRIMARY, 1)
    btn.Parent = parent

    local enabled = cfg.enabled ~= false
    local baseBg = cfg.bgColor or Theme.WHITE
    local baseTx = cfg.textColor or Theme.PRIMARY
    local baseBd = cfg.borderColor or Theme.PRIMARY

    if not enabled then
        btn.BackgroundColor3 = Theme.DISABLED_BG
        btn.TextColor3 = Theme.DISABLED_FG
        st.Color = Theme.BORDER
    end

    btn.MouseEnter:Connect(function()
        if not enabled then return end
        tw(btn, EASE_FAST, {
            BackgroundColor3 = Theme.HOVER_BG,
            TextColor3 = Theme.PRIMARY_DK,
            Position = UDim2.new(0, X, 0, Y - 1),
        })
        tw(st, EASE_FAST, { Color = Theme.PRIMARY_DK })
    end)
    btn.MouseLeave:Connect(function()
        if not enabled then return end
        tw(btn, EASE, {
            BackgroundColor3 = baseBg,
            TextColor3 = baseTx,
            Position = UDim2.new(0, X, 0, Y),
        })
        tw(st, EASE, { Color = baseBd })
    end)
    btn.MouseButton1Down:Connect(function()
        if not enabled then return end
        tw(btn, EASE_FAST, {
            BackgroundColor3 = Theme.PRIMARY_DK,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Position = UDim2.new(0, X, 0, Y),
        })
        tapPulse(btn, "Size",
            UDim2.new(0, W, 0, H),
            UDim2.new(0, W * 0.94, 0, H * 0.94),
            0.08)
    end)
    btn.MouseButton1Up:Connect(function()
        if not enabled then return end
        if btn:IsMouseOver() then
            tw(btn, EASE, {
                BackgroundColor3 = Theme.HOVER_BG,
                TextColor3 = Theme.PRIMARY_DK,
                Position = UDim2.new(0, X, 0, Y - 1),
            })
        else
            tw(btn, EASE, {
                BackgroundColor3 = baseBg,
                TextColor3 = baseTx,
                Position = UDim2.new(0, X, 0, Y),
            })
        end
    end)
    if cfg.onClick and enabled then
        btn.MouseButton1Click:Connect(function() cfg.onClick(btn) end)
    end
    return btn
end

--=================== Toggle ===================
local function createToggle(parent, cfg)
    local W, H = cfg.w or 36, cfg.h or 20

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Position = UDim2.new(0, cfg.x or 0, 0, cfg.y or 0)
    container.Size = UDim2.new(0, W, 0, H)
    container.ZIndex = cfg.zIndex or 5
    container.Parent = parent

    local track = Instance.new("Frame")
    track.BackgroundColor3 = Theme.TRACK
    track.BorderSizePixel = 0
    track.Size = UDim2.new(1, 0, 1, 0)
    corner(track, H / 2)
    track.ZIndex = 5
    track.Parent = container

    local knobSize = H - 4
    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Size = UDim2.new(0, knobSize, 0, knobSize)
    knob.Position = UDim2.new(0, 2, 0, 2)
    corner(knob, knobSize / 2)
    knob.ZIndex = 6
    knob.Parent = container

    local state = cfg.value or false
    local onChange = cfg.onChange
    local onColor = cfg.onColor or Theme.PRIMARY
    local offColor = cfg.offColor or Theme.TRACK

    local function apply(animate, elastic)
        local info = animate and (elastic and EASE_BACK or EASE) or EASE_NONE
        tw(track, animate and EASE or EASE_NONE, {
            BackgroundColor3 = state and onColor or offColor,
        })
        local targetX = state and (W - knobSize - 2) or 2
        tw(knob, info, { Position = UDim2.new(0, targetX, 0, 2) })
    end
    apply(false, false)

    local click = Instance.new("TextButton")
    click.BackgroundTransparency = 1
    click.Text = ""
    click.AutoButtonColor = false
    click.Size = UDim2.new(1, 0, 1, 0)
    click.ZIndex = 7
    click.Parent = container

    click.MouseButton1Down:Connect(function()
        tw(container, EASE_FAST, { Size = UDim2.new(0, W - 2, 0, H - 2) })
    end)
    click.MouseButton1Up:Connect(function()
        tw(container, EASE_BACK, { Size = UDim2.new(0, W, 0, H) })
    end)
    click.MouseButton1Click:Connect(function()
        state = not state
        apply(true, true)
        if onChange then onChange(state) end
    end)

    return { container = container, getValue = function() return state end }
end

--=================== Slider ===================
local function createSlider(parent, cfg)
    local W, H = cfg.w or 220, cfg.h or 22
    local minV, maxV = cfg.min or 0, cfg.max or 100
    local value = cfg.value or minV
    local onChange = cfg.onChange
    local primaryColor = cfg.color or Theme.PRIMARY

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Position = UDim2.new(0, cfg.x or 0, 0, cfg.y or 0)
    container.Size = UDim2.new(0, W, 0, H)
    container.ZIndex = cfg.zIndex or 5
    container.Parent = parent

    local trackH = 4
    local track = Instance.new("Frame")
    track.BackgroundColor3 = Theme.TRACK
    track.BorderSizePixel = 0
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.Position = UDim2.new(0, 0, 0.5, 0)
    track.Size = UDim2.new(1, 0, 0, trackH)
    corner(track, trackH / 2)
    track.ZIndex = 5
    track.Parent = container

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = primaryColor
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    corner(fill, trackH / 2)
    fill.ZIndex = 6
    fill.Parent = track

    local knobSize = 14
    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = primaryColor
    knob.BorderSizePixel = 0
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Size = UDim2.new(0, knobSize, 0, knobSize)
    corner(knob, knobSize / 2)
    knob.ZIndex = 7
    knob.Parent = container

    local function ratio()
        if maxV == minV then return 0 end
        return math.clamp((value - minV) / (maxV - minV), 0, 1)
    end

    local function applyVisual(animate)
        local r = ratio()
        local trackW = track.AbsoluteSize.X
        if trackW <= 0 then return end
        tw(fill, animate and EASE_FAST or EASE_NONE, { Size = UDim2.new(r, 0, 1, 0) })
        tw(knob, animate and EASE_FAST or EASE_NONE, { Position = UDim2.new(0, r * trackW, 0.5, 0) })
    end

    local function setValue(v, silent)
        v = math.clamp(v, minV, maxV)
        if v ~= value then
            value = v
            applyVisual(true)
            if not silent and onChange then onChange(value) end
        end
    end

    local dragging = false
    local function fromAbsX(absX)
        local sx = track.AbsolutePosition.X
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local r = math.clamp((absX - sx) / w, 0, 1)
        setValue(minV + r * (maxV - minV))
    end

    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.ZIndex = 8
    hit.Parent = container

    hit.MouseEnter:Connect(function()
        if dragging then return end
        tw(knob, EASE_FAST, { Size = UDim2.new(0, knobSize + 4, 0, knobSize + 4) })
    end)
    hit.MouseLeave:Connect(function()
        if dragging then return end
        tw(knob, EASE, { Size = UDim2.new(0, knobSize, 0, knobSize) })
    end)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tw(knob, EASE_FAST, { Size = UDim2.new(0, knobSize + 6, 0, knobSize + 6) })
            fromAbsX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
            fromAbsX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                tw(knob, EASE_BACK, { Size = UDim2.new(0, knobSize, 0, knobSize) })
            end
        end
    end)

    task.defer(function() task.wait(0.05); applyVisual(false) end)

    return {
        container = container,
        getValue = function() return value end,
        setValue = setValue,
    }
end

