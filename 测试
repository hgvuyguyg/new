-- 一个 checkbox = 一个开关，勾上跑，取消停
-- ==========================================================

if _G.__LUCKY_COIN_SHOWN then
    warn("[LUCKY] 已运行")
    return
end
_G.__LUCKY_COIN_SHOWN = true

-- 加载 Lumen UI
if not _G.ui then
    local url = "https://cdn.jsdelivr.net/gh/hgvuyguyg/new@main/ui"
    local ok, res = pcall(function() return game:HttpGet(url, true) end)
    if not ok or type(res) ~= "string" or #res < 200 then
        warn("[LUCKY] 库加载失败")
        _G.__LUCKY_COIN_SHOWN = nil
        return
    end
    local rok, rerr = pcall(function() loadstring(res)() end)
    if not rok or not _G.ui then
        warn("[LUCKY] 库执行失败: " .. tostring(rerr))
        _G.__LUCKY_COIN_SHOWN = nil
        return
    end
end

local ui = _G.ui
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- ============ 配置 ============
local CONFIG = {
    interval      = 0.05,   -- 0.01 ~ 1
    waitTimeout   = 1.5,    -- 0.5 ~ 5
    skipBronze    = false,
    sortRareFirst = true,
}

local state = {
    coin   = {running=false, stopped=false, ok=0, fail=0, skip=0, total=0, cur=0, last="就绪"},
    clover = {running=false, stopped=false, ok=0, fail=0, skip=0, total=0, cur=0, last="就绪"},
}

-- ============ 逻辑 ============
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function tryOne(item, partName)
    if not (item and item.Parent) then return "skip" end
    local part = item:FindFirstChild(partName, true)
    local pos = part and part.Position
    if not pos then
        for _, c in ipairs(item:GetDescendants()) do
            if c:IsA("BasePart") then pos = c.Position; break end
        end
    end
    local hrp = getHRP()
    if not (pos and hrp) then return "fail" end
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1, 0))
    local endT = tick() + CONFIG.waitTimeout
    while tick() < endT and item.Parent do task.wait(0.02) end
    if item.Parent then return "fail" end
    return "ok"
end

local function doCollect(folderName, partName, st, label)
    st.running = true
    st.stopped = false
    st.ok, st.fail, st.skip, st.cur, st.total = 0, 0, 0, 0, 0

    local folder = workspace:FindFirstChild(folderName)
    if not folder then
        st.last = "找不到 " .. folderName
        st.running = false
        ui.notify({type="error", title="错误", message=st.last, duration=3})
        return
    end

    local list = folder:GetChildren()
    st.total = #list

    if CONFIG.sortRareFirst and folderName == "coins" then
        local order = {almaz=1, tetracion=2, gold=3, silver=4, bronze=5}
        table.sort(list, function(a, b)
            return (order[a.Name] or 99) < (order[b.Name] or 99)
        end)
    end

    ui.notify({type="info", title="开始",
        message=string.format("%s 共 %d 个", label, #list), duration=3})

    local t0 = tick()
    for i, item in ipairs(list) do
        if st.stopped then
            st.last = string.format("已停止于 %d/%d", i, #list)
            break
        end
        st.cur = i
        local shouldSkip = false
        if not (item and item.Parent) then
            shouldSkip = true
        elseif CONFIG.skipBronze and folderName == "coins" and item.Name == "bronze" then
            shouldSkip = true
        end
        if shouldSkip then
            st.skip = st.skip + 1
        else
            local r = tryOne(item, partName)
            if r == "ok" then st.ok = st.ok + 1
            elseif r == "fail" then st.fail = st.fail + 1
            else st.skip = st.skip + 1 end
            task.wait(CONFIG.interval)
        end
        if i % 20 == 0 then
            warn(string.format("[%s] %d/%d ✓%d ✗%d ⏭%d %.0fs",
                label, i, #list, st.ok, st.fail, st.skip, tick() - t0))
        end
    end

    st.last = string.format("完成 ✓%d ✗%d ⏭%d / %d (%.0fs)",
        st.ok, st.fail, st.skip, st.total, tick() - t0)
    st.running = false
    ui.notify({type="success", title=label .. " 完成", message=st.last, duration=5})
end

-- 尝试把 checkbox 程序化取消勾选（多种 API 兜底）
local function resetCheckbox(ref)
    if not ref then return end
    pcall(function() ref.value = false end)
    pcall(function() ref:Set(false) end)
    pcall(function() ref:SetValue(false) end)
    pcall(function() ref:setValue(false) end)
end

